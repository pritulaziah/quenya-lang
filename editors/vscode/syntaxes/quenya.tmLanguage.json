{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quenya",
  "scopeName": "source.quenya",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-declaration" },
    { "include": "#variable-declaration" },
    { "include": "#struct-declaration" },
    { "include": "#impl-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#enum-variant" },
    { "include": "#wildcard" },
    { "include": "#function-call" },
    { "include": "#identifiers" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#braces" },
    { "include": "#brackets" },
    { "include": "#parens" },
    { "include": "#separators" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.quenya"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.quenya",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.quenya"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(maita)[ \\t]+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.quenya" },
        "2": { "name": "entity.name.function.quenya" }
      }
    },
    "variable-declaration": {
      "match": "(?<![\\p{L}\\p{N}_])(essë)[ \\t]+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.quenya" },
        "2": { "name": "variable.other.quenya" }
      }
    },
    "struct-declaration": {
      "match": "\\b(canta)[ \\t]+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.quenya" },
        "2": { "name": "entity.name.type.quenya" }
      }
    },
    "impl-declaration": {
      "match": "\\b(carasta)[ \\t]+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.quenya" },
        "2": { "name": "entity.name.type.quenya" }
      }
    },
    "enum-declaration": {
      "match": "\\b(cilmë)[ \\t]+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.quenya" },
        "2": { "name": "entity.name.type.quenya" }
      }
    },
    "enum-variant": {
      "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)::([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "entity.name.type.quenya" },
        "2": { "name": "entity.name.type.enum.quenya" }
      }
    },
    "wildcard": {
      "match": "(?<![\\p{L}\\p{N}_])_(?![\\p{L}\\p{N}_])",
      "name": "variable.language.wildcard.quenya"
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(quétë|notië|napan)(?![\\p{L}\\p{N}_])",
          "name": "support.function.builtin.quenya"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(essë|maita|canta|carasta|cilmë)(?![\\p{L}\\p{N}_])",
          "name": "storage.type.quenya"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(entul|qui|mal|yallumë|ilyë|mí|rac|lelya|nam)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.quenya"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])immo(?![\\p{L}\\p{N}_])",
          "name": "variable.language.self.quenya"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(naitë)(?![\\p{L}\\p{N}_])",
          "name": "constant.language.boolean.quenya"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(lá|ar|hya)(?![\\p{L}\\p{N}_])",
          "name": "keyword.operator.logical.quenya"
        }
      ]
    },
    "types": {
      "match": "(?<![\\p{L}\\p{N}_])(Notessë|Quetta|Nanwa|Er|Técma)(?![\\p{L}\\p{N}_])",
      "name": "support.type.quenya"
    },
    "function-call": {
      "match": "([\\p{L}_][\\p{L}\\p{N}_]*)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.quenya" }
      }
    },
    "identifiers": {
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
      "name": "variable.other.quenya"
    },
    "numbers": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.integer.quenya"
    },
    "operators": {
      "match": "==|!=|<=|>=|->|=>|::|[=+*/%<>:.-]",
      "name": "keyword.operator.quenya"
    },
    "braces": {
      "patterns": [
        {
          "match": "\\{",
          "name": "punctuation.section.block.begin.quenya"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.block.end.quenya"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.quenya"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.quenya"
        }
      ]
    },
    "parens": {
      "patterns": [
        {
          "match": "\\(",
          "name": "punctuation.section.parens.begin.quenya"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.quenya"
        }
      ]
    },
    "separators": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.quenya"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.quenya"
        }
      ]
    }
  }
}
