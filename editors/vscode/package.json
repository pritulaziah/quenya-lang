{
  "name": "quenya-lang",
  "displayName": "Quenya Lang",
  "description": "Syntax highlighting for the Quenya programming language.",
  "version": "0.1.3",
  "publisher": "pritulaziah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pritulaziah/quenya-lang.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quenya",
        "aliases": [
          "Quenya",
          "quenya"
        ],
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quenya",
        "scopeName": "source.quenya",
        "path": "./syntaxes/quenya.tmLanguage.json"
      }
    ]
  }
}
