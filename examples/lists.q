# Lists, indexing, and iteration.
ea xs = [1, 2, 3];

# Add an element and change the first one.
napan(xs, 4);
xs[0] = 10;

# Print the list and its length.
quete(xs);
quete(not(xs));

# Skip 2 and stop at 4.
ilya x mi xs {
    qui x == 2 {
        lelya;
    }
    qui x == 4 {
        rac;
    }
    quete(x);
}
